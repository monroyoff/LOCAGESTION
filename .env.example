# Configuration de l'environnement LOCAGESTION

# ==========================================
# 1. SERVEUR SMTP (Expédition réelle d'emails)
# ==========================================
# Exemples avec Gmail (Mot de passe d'application) :
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=mon-agence@gmail.com
# SMTP_PASS=abcd efgh ijkl mnop
# SMTP_FROM="LOCAGESTION" <mon-agence@gmail.com>

# Exemples avec Brevo / Sendinblue (Gratuit 300 emails/jour) :
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=votre-email@domaine.com
# SMTP_PASS=votre-cle-smtp-brevo
# SMTP_FROM="LOCAGESTION Bénin" <contact@locagestion.bj>

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="LOCAGESTION" <notifications@locagestion.app>

# ==========================================
# 2. PASSERELLE SMS AUTOMATIQUE (Optionnel)
# ==========================================
# Si non configuré, le système utilise l'envoi WhatsApp et SMS direct natif en 1 clic.
# Twilio :
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# Termii (Passerelle SMS Afrique de l'Ouest) :
# TERMII_API_KEY=
# TERMII_SENDER_ID=LOCAGESTION

# ==========================================
# 3. URL PUBLIQUE DE LA PLATEFORME (Production)
# ==========================================
NEXT_PUBLIC_APP_URL=https://locagestion.site
SITE_DOMAIN=locagestion.site

